# Copy to .env (never commit the real one) and load it before starting the app,
# e.g.  set -a; source .env; set +a; java -jar target/mrdiet-api.jar

# --- Required ---------------------------------------------------------------
DB_URL=jdbc:mysql://localhost:3306/mrdietweb?useUnicode=true&characterEncoding=utf8&tinyInt1isBit=false
DB_USER=mrdiet
DB_PASS=change-me
# 32+ random characters. Generate one with:  openssl rand -base64 48
JWT_SECRET=

# --- Site -------------------------------------------------------------------
PORT=8081
APP_PUBLIC_URL=https://mrdietplan.in
CORS_ORIGINS=https://mrdietplan.in,https://www.mrdietplan.in,http://localhost:8080
UPLOAD_DIR=/var/www/mrdiet/uploads
APP_TIMEZONE=Asia/Kolkata

# --- Keys (optional here if you keep them in Admin → Settings; the admin value wins) ---
OPENAI_API_KEY=
GOOGLE_CLIENT_ID=785889991022-6jfg7dqe45cfecf1n0e3kubor89lof3p.apps.googleusercontent.com
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# --- Tuning -----------------------------------------------------------------
REMINDERS_ENABLED=true
AI_MAX_PER_HOUR=30
